# ====================================================================
# Gitignore para Planejador BNCC
# ====================================================================

# Ambientes e Segredos (Environment & Secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
!.env.template

# Dependências (Node.js / JS / TS)
node_modules/
jspm_packages/
web_modules/
.pnp/
.pnp.js

# Builds e Saídas (Build outputs)
dist/
build/
out/
.next/
.nuxt/
.output/
.astro/
.cache/
.parcel-cache/
.turbo/
.vercel/

# Logs e Depuração (Logs & Debugging)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testes e Cobertura (Testing & Coverage)
coverage/
.nyc_output/
*.lcov

# Python (se utilizado no backend ou automações)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Banco de dados e armazenamento local (Databases & SQLite)
*.sqlite
*.sqlite3
*.db

# Configurações de IDEs e Editores
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Arquivos do Sistema Operacional (OS files)
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~

# Arquivos temporários e backups
*.tmp
*.temp
*.bak
*.swp
*.swo

# Estado local do Spec Kit / Ferramentas de IA
.specify/feature.json
.specify/extensions/*/local-config.yml
